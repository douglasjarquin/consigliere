{
  "name": "consigliere-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "portless": "consigliere",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/write-public.mjs && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:e2e": "playwright test",
    "test": "aubr test:unit && aubr test:e2e"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.62.1",
    "@types/node": "25.2.3",
    "astro": "7.3.1",
    "typescript": "5.9.3"
  }
}
