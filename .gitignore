# Boss-private operational home — never tracked.
data/
state/
config/
host/
projects/
.no-mistakes/

# Local review artifacts and macOS noise — never tracked.
.lavish/
.DS_Store

# Executor worktrees (Agent isolation) — never tracked.
.claude/worktrees/

# Python bytecode caches (bin/cs-detach.py) — build artifacts, never tracked.
__pycache__/

# graft's local graph cache — regenerable, not committed (run `graft build`).
# Left unanchored on purpose: graft's own ensureGitignored (dist/context/node-file.js:69-91)
# matches only literal "graft/", so an anchored /graft/ self-reverts on the next
# `graft build` at the repo root. The unanchored line also matches skills/graft/,
# so the line below re-admits the committed skill.
graft/
!skills/graft/
